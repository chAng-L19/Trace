# Server-only CloakBrowser migration: copy frozen SDK/binary; install nothing.
# Preserve other accepted dependencies and flatten the replaced browser layers.
ARG BASE_IMAGE=trace:frontend-docker-20261029
FROM ${BASE_IMAGE} AS updated
USER root
RUN test -x /usr/bin/tini \
    && test -x /usr/bin/xvfb-run \
    && command -v flock \
    && rm -rf /opt/trace/runtime/pi /opt/trace/runtime/chromium /opt/trace/runtime/playwright \
       /opt/trace/runtime/site-packages/DrissionPage \
       /opt/trace/runtime/site-packages/DrissionPage-*.dist-info \
       /opt/trace/runtime/site-packages/drissionpage-*.dist-info \
       /opt/trace/tools/web-analysis \
       /opt/trace/.trace/skills/drissionpage \
       /opt/trace/.trace/skills/playwright-cli
COPY runtime/cloakbrowser/ /opt/trace/runtime/cloakbrowser/
COPY tools/web-analysis/ /opt/trace/tools/web-analysis/
# Leave frozen non-browser skills and their modes/owners untouched.
COPY .trace/skills/cloakbrowser/ /opt/trace/.trace/skills/cloakbrowser/
RUN chmod -R a+rX /opt/trace/runtime/cloakbrowser \
    && test -x /opt/trace/runtime/cloakbrowser/binary/chrome \
    && PYTHONPATH=/opt/trace/runtime/cloakbrowser/site-packages:/opt/trace/runtime/site-packages:/opt/trace/runtime/ASC \
       python3 -c 'import cloakbrowser, importlib.util, sys; assert sys.version_info[:2] == (3, 12); assert cloakbrowser.__version__ == "0.6.4"; assert importlib.util.find_spec("DrissionPage") is None' \
    && cd /opt/trace/tools/web-analysis \
    && node --input-type=module -e 'import {readFileSync} from "node:fs"; if(JSON.parse(readFileSync("node_modules/cloakbrowser/package.json")).version!=="0.6.4") throw new Error("CloakBrowser must be pinned to 0.6.4"); await import("cloakbrowser");'
COPY bin/trace /usr/local/bin/trace
COPY prompts/ /opt/trace/prompts/
COPY licenses/ /opt/trace/licenses/
COPY examples/tsecbench-task.md /opt/trace/examples/tsecbench-task.md
COPY examples/tsecbench_api.py /opt/trace/examples/tsecbench_api.py
COPY docker/entrypoint.sh /opt/trace/docker/entrypoint.sh
RUN chmod 0755 /usr/local/bin/trace /opt/trace/docker/entrypoint.sh

# A new rootfs layer omits superseded browser files and historical layers.
# No --chown: preserve root-owned binaries and trace-owned writable directories.
# This is release compaction, not an incremental-cache/pull-size optimization.
FROM scratch
COPY --from=updated / /
# scratch inherits no metadata. Preserve non-browser config from the old image.
LABEL org.opencontainers.image.version="22.04"
ENV PATH="/opt/trace/runtime/python/bin:/opt/trace/runtime/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
    DEBIAN_FRONTEND=noninteractive \
    PYTHONPATH="/opt/trace/runtime/cloakbrowser/site-packages:/opt/trace/runtime/site-packages:/opt/trace/runtime/ASC" \
    PYTHONIOENCODING=utf-8 PYTHONUTF8=1 PYTHONDONTWRITEBYTECODE=1 \
    TRACE_DATA_DIR=/state TRACE_PROMPT_FILE=/opt/trace/prompts/agent.md \
    TRACE_SKILL_PATHS=/opt/trace/.trace/skills \
    TRACE_WEB_ANALYSIS_DIR=/opt/trace/tools/web-analysis \
    CLOAKBROWSER_BINARY_PATH=/opt/trace/runtime/cloakbrowser/binary/chrome \
    CLOAKBROWSER_AUTO_UPDATE=false \
    TRACE_BROWSER_NO_SANDBOX=1 \
    REA_BROWSER_NO_SANDBOX=true \
    NO_UPDATE_NOTIFIER=1 TRACE_PI_RUNTIME=
USER trace
WORKDIR /workspace
STOPSIGNAL SIGINT
ENTRYPOINT ["/usr/bin/tini", "-g", "--", "/opt/trace/docker/entrypoint.sh"]
CMD ["benchmark"]

