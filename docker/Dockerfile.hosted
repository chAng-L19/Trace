# Server-only hosted release: reuse the accepted, clean frozen runtime image.
# Pass an immutable image ID; do not inherit the live service filesystem.
ARG BASE_IMAGE
FROM ${BASE_IMAGE} AS updated
USER root
# Replace the complete built closure, not just package manifests or dist.
# pi host, localtool helpers and UI assets are embedded in bin/trace; the
# unchanged pi 1.4.0 dependency tree is inherited from the accepted base.
RUN rm -rf /opt/trace/tools/web-analysis \
    /opt/trace/.trace/skills/asc /opt/trace/.trace/skills/cloakbrowser \
    /opt/trace/.trace/skills/frida /opt/trace/.trace/skills/web-analysis
COPY tools/web-analysis/ /opt/trace/tools/web-analysis/
COPY .trace/skills/asc/ /opt/trace/.trace/skills/asc/
COPY .trace/skills/cloakbrowser/ /opt/trace/.trace/skills/cloakbrowser/
COPY .trace/skills/frida/ /opt/trace/.trace/skills/frida/
COPY .trace/skills/web-analysis/ /opt/trace/.trace/skills/web-analysis/
COPY licenses/ /opt/trace/licenses/
# Build context supplies the tiny, hash-locked offline bundle; never fetch at startup.
COPY runtime/capabilities/ /tmp/trace-capabilities/
COPY docker/install-capabilities.sh docker/capabilities.sha256 /tmp/trace-capability-build/
RUN sh /tmp/trace-capability-build/install-capabilities.sh /tmp/trace-capabilities /tmp/trace-capability-build/capabilities.sha256 \
    && rm -rf /tmp/trace-capabilities /tmp/trace-capability-build
COPY bin/trace /usr/local/bin/trace
COPY prompts/agent.md /opt/trace/prompts/agent.md
COPY examples/tsecbench-task.md /opt/trace/examples/tsecbench-task.md
COPY examples/tsecbench_api.py /opt/trace/examples/tsecbench_api.py
COPY docker/entrypoint.sh /opt/trace/docker/entrypoint.sh
RUN chmod 0755 /usr/local/bin/trace /opt/trace/docker/entrypoint.sh

# Preserve the immutable clean base layers. docker save includes every layer,
# so this is a complete offline image, not a delta requiring a separate base.
# Avoid copying a second full rootfs on the disk-constrained build server.
FROM updated
LABEL org.opencontainers.image.version="22.04"
ENV PATH="/opt/trace/runtime/python/bin:/opt/trace/runtime/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
    DEBIAN_FRONTEND=noninteractive \
    PYTHONPATH="/opt/trace/runtime/cloakbrowser/site-packages:/opt/trace/runtime/site-packages:/opt/trace/runtime/ASC" \
    PYTHONIOENCODING=utf-8 PYTHONUTF8=1 PYTHONDONTWRITEBYTECODE=1 \
    TRACE_DATA_DIR=/state TRACE_PROMPT_FILE=/opt/trace/prompts/agent.md \
    TRACE_EXEC_RESOURCE_MODE=process-group \
    TRACE_SKILL_PATHS=/opt/trace/.trace/skills \
    TRACE_WEB_ANALYSIS_DIR=/opt/trace/tools/web-analysis \
    CLOAKBROWSER_BINARY_PATH=/opt/trace/runtime/cloakbrowser/binary/chrome \
    CLOAKBROWSER_AUTO_UPDATE=false \
    TRACE_BROWSER_NO_SANDBOX=1 REA_BROWSER_NO_SANDBOX=true \
    NO_UPDATE_NOTIFIER=1 TRACE_PI_RUNTIME=/opt/trace/runtime/pi
USER trace
WORKDIR /workspace
STOPSIGNAL SIGINT
ENTRYPOINT ["/usr/bin/tini", "-g", "--", "/opt/trace/docker/entrypoint.sh"]
CMD ["benchmark"]
