# 示例，不是已验收配置：在托管页面“从 .env 导入”粘贴正文后解析。
# 模型上游须在平台白名单内；URL加.tsecbench.gw并使用http，保留路径。
# 下列URL/模型/key须匹配同一上游；不要直接复制正式服务中任意Provider。
# 不要把密钥写入镜像；平台本地模式另用原始可达上游，不使用托管网关。
TRACE_PROVIDER_URL=http://api.deepseek.com.tsecbench.gw
TRACE_MODEL=deepseek-flash
TRACE_PROVIDER_KEY=填写你自己的模型API密钥
TRACE_CONTEXT_TOKENS=250000
TRACE_OUTPUT_RESERVE=16384
TRACE_REQUIRE_VERIFIED_COMPLETION=true
# 托管镜像默认普通容器兼容模式：保留取消/清理与共享输出预算。
# 每条命令没有独立 memory/PID 硬上限；容器总资源限制由平台提供。
# 通用服务器默认仍为 cgroup；不要填伪 TRACE_EXEC_CGROUP_ROOT 路径。
TRACE_EXEC_RESOURCE_MODE=process-group
TRACE_MAX_SECONDS=21180
TRACE_MAX_ROUNDS=0
TRACE_MAX_ACTIONS=0
# P2：可选整树累计准入预算；不设置或0表示不限，不是隐式停止轮数。
# TRACE_TREE_MAX_DEPTH=0
# TRACE_TREE_MAX_WORKERS=0
# TRACE_TREE_MAX_MODEL_REQUESTS=0
# TRACE_TREE_MAX_TOKENS=0
# TRACE_TREE_MAX_SECONDS=0
# TRACE_TREE_MAX_COST=0
# TRACE_TREE_CURRENCY=USD
# BENCHMARK_BASE_URL / BENCHMARK_TOKEN 由平台自动注入。
