# Copy to ~/.config/trace/trace.env (systemd) or .env (Compose), chmod 600.
# EnvironmentFile / Compose syntax: no `export`, shell commands, or substitutions.
# Only used when the persistent user database is first created.
TRACE_ADMIN_USERNAME=trace
TRACE_ADMIN_PASSWORD=admin@123
# Leave optional Provider overrides empty to keep persisted Web settings on restart.
TRACE_MODEL=
TRACE_API_BASE_URL=
TRACE_API_KEY_ENV=
OPENAI_API_KEY=
TRACE_API_TIMEOUT_SECONDS=
TRACE_MODEL_CONTEXT_TOKENS=
