{
  "name": "@trace/web-analysis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Selected REA JavaScript/web/Electron implementation for Trace localtool; no REA runtime",
  "engines": {
    "node": "^22.19.0 || >=24.11.0"
  },
  "imports": {
    "#javascript-analysis-worker": "./dist/composition/javascriptAnalysisWorkerProcess.js"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "test:integration": "node --test test/integration.test.mjs test/resources.test.mjs",
    "test:live": "node --test test/live.test.mjs",
    "catalog": "node dist/trace-cli.js --catalog"
  },
  "dependencies": {
    "@babel/parser": "8.0.4",
    "@babel/types": "8.0.4",
    "@electron/asar": "4.2.0",
    "@jridgewell/trace-mapping": "0.3.31",
    "@xmldom/xmldom": "0.9.12",
    "@zip.js/zip.js": "2.15.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "3.0.0",
    "cloakbrowser": "0.6.4",
    "har-schema": "2.0.0",
    "jsonc-parser": "3.3.1",
    "lossless-json": "4.3.1",
    "parse5": "8.0.1",
    "playwright-core": "1.58.2",
    "semver": "7.8.5",
    "ws": "8.21.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "vitest": "5.0.3",
