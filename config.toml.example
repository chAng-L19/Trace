[provider]
# Set model to enable model execution; keep credentials in the named environment variable.
provider = "openai-compatible"
model = ""
base_url = "https://api.openai.com/v1"
api_key_env = "OPENAI_API_KEY"
max_output_tokens = 8192
reasoning_effort = ""
# Native Claude: provider="anthropic", base_url="https://api.anthropic.com/v1",
# api_key_env="ANTHROPIC_API_KEY" and your enabled model ID.
# thinking_type = "enabled"
# thinking_budget_tokens = 4096  # Must be lower than max_output_tokens.

[automation]
tool_priority = []
max_actions_per_cycle = 64
action_timeout_seconds = 60
max_retries_per_action = 2
max_domains = 7
max_hypothesis_branches = 4
handoff_ttl_seconds = 900

# Trace's built-in browser MCP uses the current Python, installed Playwright
# and existing Chrome/Chromium; it never invokes npx or downloads dependencies.
# This is not Microsoft's Playwright MCP server. Omit command to use the preset.
[mcp_servers.playwright]
preset = "playwright"
scope = "run"
args = ["-m", "redteam_agent.runtime.browser_mcp", "--workspace", "{workspace}"]
startup_timeout_seconds = 120
tool_timeout_seconds = 120
