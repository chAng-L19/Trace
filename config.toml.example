[automation]
tool_priority = []
max_actions_per_cycle = 64
action_timeout_seconds = 60
max_retries_per_action = 2
max_domains = 7
max_hypothesis_branches = 4
handoff_ttl_seconds = 900

# Run-scoped Playwright keeps browser state isolated between operations. The
# preset exposes a focused accessibility/network catalog instead of every MCP
# tool, which reduces prompt tokens without hiding core browser capabilities.
[mcp_servers.playwright]
preset = "playwright"
scope = "run"
command = "npx"
args = ["-y", "@playwright/mcp@0.0.79", "--isolated", "--headless", "--image-responses=omit", "--codegen=none", "--block-service-workers", "--output-dir={workspace}/playwright-output", "--output-max-size=52428800"]
startup_timeout_seconds = 120
tool_timeout_seconds = 120

# Requires IDA Pro 8.3+ with idalib activated and uv on PATH. Each analysis run
# receives its own MCP supervisor connection; every IDA tool call still names
# the database explicitly, so database state is never inferred globally.
[mcp_servers.ida]
preset = "ida"
scope = "run"
command = "uv"
args = ["run", "idalib-mcp", "--stdio", "--max-workers", "4"]
startup_timeout_seconds = 180
tool_timeout_seconds = 180

# IDA Free does not expose idalib or the IDA Pro MCP plugin. Use the bundled
# read-only batch bridge after installing IDA Free and locating idat64.exe.
# The downloaded ida-free-pc_94_x64win.exe is an installer, not this runtime.
# [mcp_servers.ida_free]
# preset = "ida_free"
# scope = "run"
# `{python}` binds to the current Agent runtime interpreter.
# command = "{python}"
# args = ["-m", "redteam_agent.runtime.ida_free_bridge", "--ida", "C:\\Program Files\\IDA Free 9.4\\idat64.exe"]
# startup_timeout_seconds = 180
# tool_timeout_seconds = 240
